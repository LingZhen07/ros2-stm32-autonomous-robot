					reg = <0x05 0x40000 0x00 0x10000 0x05 0x8000000 0x00 0x2000000 0x05 0x28000000 0x00 0x8000000 0x05 0x20028000 0x00 0x4000 0x05 0x21000000 0x00 0x1000000 0x05 0x20800000 0x00 0x800000 0x05 0x20008000 0x00 0x8000 0x05 0x20004000 0x00 0x4000 0x05 0x20100000 0x00 0x100000 0x05 0x20200000 0x00 0x100000>;
