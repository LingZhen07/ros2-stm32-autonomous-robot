/dts-v1/;

/ {
	compatible = "hisilicon,hi1910B-evb\0hisilicon,ascend610";
	hisi,boardid = <0x80 0x00 0x28 0x0b>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Orange Pi Ai Pro 8T";

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			numa-node-id = <0x00>;
			phandle = <0x02>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x100>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			numa-node-id = <0x00>;
			phandle = <0x03>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x200>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			numa-node-id = <0x00>;
			phandle = <0x04>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x300>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			numa-node-id = <0x00>;
			phandle = <0x05>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};
		};

		psci {
			compatible = "arm,psci-0.2";
			method = "smc";
		};
	};

	interrupt-controller@D0000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		interrupt-controller;
		#redistributor-regions = <0x01>;
		redistributor-stride = <0x00 0x40000>;
		reg = <0x00 0xd0000000 0x00 0x10000 0x00 0xd0100000 0x00 0x800000>;
		interrupts = <0x01 0x09 0xff04>;
		linux,phandle = <0x01>;
		phandle = <0x01>;
		enable-init-all-gicr;

		interrupt-controller@D2000000 {
			compatible = "arm,gic-v3-its";
			msi-controller;
			#msi-cells = <0x01>;
			reg = <0x00 0xd2000000 0x00 0x100000>;
			phandle = <0x0f>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		uart@C4010000 {
			compatible = "arm,sbsa-uart";
			reg = <0x00 0xc4010000 0x00 0x10000>;
			interrupts = <0x00 0xa9 0x04>;
			current-speed = <0x1c200>;
		};

		watchdog@c42e0000 {
			compatible = "arm,sbsa-gwdt";
			reg = <0x00 0xc42e0000 0x00 0x10000 0x00 0xc42f0000 0x00 0x10000>;
			interrupts = <0x00 0x10a 0x04>;
			timeout-sec = <0x0a>;
		};

		refclk150M {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8f0d180>;
			clock-output-names = "refclk";
			phandle = <0x06>;
		};

		uart@82230000 {
			status = "disabled";
			compatible = "arm,pl011\0arm,primecell";
			reg = <0x00 0x82230000 0x00 0x1000>;
			interrupts = <0x00 0xab 0x04>;
			current-speed = <0x1c200>;
			arm,primecell-periphid = <0x241011>;
			clocks = <0x06>;
			clock-names = "apb_pclk";
			pinctrl-names = "default\0idle";
			pinctrl-0 = <0x07 0x08>;
			pinctrl-1 = <0x09 0x0a>;
		};

		uart@401080000 {
			compatible = "arm,pl011\0arm,primecell";
			reg = <0x04 0x1080000 0x00 0x1000>;
			interrupts = <0x00 0x11b 0x04>;
			current-speed = <0x1c200>;
			arm,primecell-periphid = <0x241011>;
			clocks = <0x06>;
			clock-names = "apb_pclk";
			pinctrl-names = "default\0idle";
			pinctrl-0 = <0x0b 0x0c>;
			pinctrl-1 = <0x0d 0x0e>;
		};
	};

	memory0@numa0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x78000000>;
		numa-node-id = <0x00>;
	};

	memory1_ts0@numa0 {
		device_type = "memory";
		reg = <0x20 0x80000000 0x00 0x20000000>;
		numa-node-id = <0x02>;
		hotpluggable;
	};

	memory1_p2p@numa0 {
		device_type = "memory";
		reg = <0x20 0xa0000000 0x00 0x00>;
		numa-node-id = <0x01>;
	};

	memory1@numa0 {
		device_type = "memory";
		reg = <0x20 0x80000000 0x01 0x00>;
		numa-node-id = <0x00>;
	};

	memory2@numa0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
		numa-node-id = <0x00>;
	};

	memory3@numa0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
		numa-node-id = <0x00>;
	};

	memory4@numa0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
		numa-node-id = <0x00>;
	};

	memory5@numa0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
		numa-node-id = <0x00>;
	};

	distance-map {
		compatible = "numa-distance-map-v1";
		distance-matrix = <0x00 0x02 0x64 0x01 0x02 0x64>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x04>;
	};

	trunk@0x22140000 {
		compatible = "ts dynamic";
		no-map;
		reg = <0x00 0x22140000 0x00 0x100000>;
		phandle = <0x10>;
	};

	os_kbox {
		compatible = "os_kbox";
		reg = <0x00 0x23910000 0x00 0x400000>;
	};

	firmware {

		sdei {
			compatible = "arm,sdei-1.0";
			method = "smc";
		};
	};

	hisi_hest@10600000 {
		compatible = "dt_apei, hest";
		reg = <0x00 0x10600000 0x00 0x400000>;
		interrupts = <0x00 0x11f 0x01>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		reserved_mem0@0 {
			no-map;
			reg = <0x00 0x00 0x00 0x10600000>;
		};

		reserved_mem0@10600000 {
			reg = <0x00 0x10600000 0x00 0x400000>;
		};

		reserved_mem0@21000000 {
			no-map;
			reg = <0x00 0x21000000 0x00 0x1740000>;
		};

		reserved_mem0@22940000 {
			no-map;
			reg = <0x00 0x22940000 0x00 0x66c0000>;
		};

		ddrdumpbuffer@0x {
			compatible = "ddr dump buffer";
			no-map;
			reg = <0x20 0xa0000000 0x00 0x2000000>;
		};

		hmi_cma_highmem {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x20000000>;
			reg = <0x20 0xa2000000 0x00 0x20000000>;
			phandle = <0x30>;
		};

		reserved_mem_kernel_log@22741000 {
			reg = <0x00 0x22741000 0x00 0x1fc000>;
		};
	};

	dvpp0_smmu0@200000000 {
		compatible = "arm,smmu-v3";
		reg = <0x02 0x00 0x00 0x40000>;
		#iommu-cells = <0x01>;
		msi-parent = <0x0f 0xff01>;
		msi-map = <0xff01 0x0f 0xff01 0x2000>;
		msi-map-mask = <0xffff>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		phandle = <0x12>;
	};

	aic_smmu@777777700 {
		compatible = "arm,smmu-v3";
		reg = <0x07 0x00 0x00 0x100000>;
		#iommu-cells = <0x01>;
		msi-parent = <0x0f 0xff03>;
		msi-map = <0xff03 0x0f 0xff03 0x2000>;
		msi-map-mask = <0xffff>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		phandle = <0x11>;
	};

	peri_smmu@80000000 {
		compatible = "arm,smmu-v3";
		reg = <0x00 0x80000000 0x00 0x100000>;
		#iommu-cells = <0x01>;
		msi-parent = <0x0f 0xff06>;
		msi-map = <0xff06 0x0f 0xff06 0x2000>;
		msi-map-mask = <0xffff>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		phandle = <0x13>;
	};

	io_smmu_controller@a0000000 {
		compatible = "arm,smmu-v3";
		reg = <0x00 0xa0000000 0x00 0x100000>;
		#iommu-cells = <0x01>;
		msi-parent = <0x0f 0xff04>;
		msi-map = <0xff04 0x0f 0xff04 0x2000>;
		msi-map-mask = <0xffff>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		phandle = <0x14>;
	};

	media_smmu@400000000 {
		compatible = "arm,smmu-v3";
		reg = <0x04 0x00 0x00 0x40000>;
		#iommu-cells = <0x01>;
		msi-parent = <0x0f 0xff07>;
		msi-map = <0xff07 0x0f 0xff07 0x2000>;
		msi-map-mask = <0xffff>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		phandle = <0x15>;
	};

	isp0_smmu0@300000000 {
		compatible = "arm,smmu-v3";
		reg = <0x03 0x00 0x00 0x40000>;
		#iommu-cells = <0x01>;
		msi-parent = <0x0f 0xff02>;
		msi-map = <0xff02 0x0f 0xff02 0x2000>;
		msi-map-mask = <0xffff>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		phandle = <0x16>;
	};

	davinci_svm {
		compatible = "hisilicon,svm";
		ranges;
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		memory-region = <0x10>;
		cpu-num = <0x04>;

		aicore {
			iommus = <0x11 0x1f>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};

		dvpp0 {
			iommus = <0x12 0x1f>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
			enable-ttb1;
			smmu-name = "dvpp_smmu_0";
			iova-range = <0xffff0000 0x00 0x04 0x00>;
		};

		peri {
			iommus = <0x13 0x1f>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};

		io {
			iommus = <0x14 0x1f>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};

		media {
			iommus = <0x15 0x1f>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};

		isp0 {
			iommus = <0x16 0x1f>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};
	};

	mpam {
		compatible = "arm,mpam";

		mpam0@mata0 {
			reg = <0x00 0xc1280000 0x00 0x10000>;
			type = <0x02>;
			numa-node-id = <0x00>;
			overflow-interrupt = <0x00>;
			overflow-flags = <0x00>;
			error-interrupt = <0x00>;
			error-interrupt-flags = <0x00>;
			not-ready-max = <0x00>;
		};

		cache0@0xC1290000 {
			reg = <0x00 0xc1290000 0x00 0x10000>;
			type = <0x01>;
			cache-id = <0x00>;
			cache-level = <0x03>;
			overflow-interrupt = <0x00>;
			overflow-flags = <0x00>;
			error-interrupt = <0x00>;
			error-interrupt-flags = <0x00>;
			not-ready-max = <0x00>;
		};
	};

	davinci_smmu_mpam {
		compatible = "hisilicon,ascend_mpam";

		ascend_mpam0 {
			parent = "davinci_svm";
			include-all-child;
		};
	};

	hi191x_pm {
		compatible = "hisilicon,hi191x-pm";
	};

	gpio8@C4060000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0x00 0xc4060000 0x00 0x1000>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <0x02>;
			snps,nr-gpios = <0x04>;
			reg = <0x00>;
			interrupt-controller;
			interrupt-parent = <0x17>;
			interrupts = <0x321 0x04 0x322 0x04 0x322 0x04 0x323 0x04>;
			status = "ok";
		};
	};

	drv_lpm_devmng {
		compatible = "hisi,lpm_dev_manager";

		sysnode@ring {
			id = <0x1f>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@isp {
			id = <0x00>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@media {
			id = <0x01>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@ao {
			id = <0x02>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@mn {
			id = <0x03>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@mata {
			id = <0x05>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@cpu {
			id = <0x06>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@peri {
			id = <0x07>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@aic {
			id = <0x08>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@io {
			id = <0x09>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};

		sysnode@dvpp {
			id = <0x0a>;
			idle_en = <0x01>;
			idle_cycle_th = <0x400>;
			force_idle = <0x00>;
			force_busy = <0x00>;
		};
	};

	drv_lpm_fault {
		compatible = "hisi,lpm_fault_manager";
		rx_fault_ipc = <0x02>;
	};

	mbigen_ao@c0150000 {
		compatible = "hisilicon,mbigen-v2";
		reg = <0x00 0xc0150000 0x00 0x10000>;

		vpc0 {
			msi-parent = <0x0f 0xff1c>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x1f>;
		};

		vpc1 {
			msi-parent = <0x0f 0xff1d>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x20>;
		};

		vdec0 {
			msi-parent = <0x0f 0xff3c>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x21>;
		};

		vdec1 {
			msi-parent = <0x0f 0xff3d>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x22>;
		};

		vdec2 {
			msi-parent = <0x0f 0xff3e>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x23>;
		};

		vdec3 {
			msi-parent = <0x0f 0xff3f>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x24>;
		};

		jpeg_jpegd0 {
			msi-parent = <0x0f 0xff10>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x25>;
		};

		jpeg_jpegd1 {
			msi-parent = <0x0f 0xff1a>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x26>;
		};

		jpeg_jpege0 {
			msi-parent = <0x0f 0xff1b>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x27>;
		};

		venc0 {
			msi-parent = <0x0f 0xff26>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x28>;
		};

		venc1 {
			msi-parent = <0x0f 0xff27>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x29>;
		};

		venc2 {
			msi-parent = <0x0f 0xff28>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x20>;
			phandle = <0x2a>;
		};

		stars {
			msi-parent = <0x0f 0xff24>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x22>;
			phandle = <0x1c>;
		};

		ipc_lp2acpu {
			msi-parent = <0x0f 0xff3a>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x04>;
			phandle = <0x1a>;
		};

		ipc_ts2acpu {
			msi-parent = <0x0f 0xff25>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x18>;
			phandle = <0x1b>;
		};

		pcie0_local {
			msi-parent = <0x0f 0xff29>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x08>;
			phandle = <0x48>;
		};

		pcie1_local {
			msi-parent = <0x0f 0xff2a>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x08>;
		};

		pcie2_local {
			msi-parent = <0x0f 0xff2b>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x08>;
		};

		pcie3_local {
			msi-parent = <0x0f 0xff2c>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x08>;
		};

		gpio8 {
			msi-parent = <0x0f 0xff46>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x04>;
			phandle = <0x17>;
		};

		vicap0 {
			msi-parent = <0x0f 0xff52>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x66>;
			phandle = <0x3b>;
		};

		viproc0 {
			msi-parent = <0x0f 0xff53>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x67>;
			phandle = <0x3c>;
		};

		vpss0 {
			msi-parent = <0x0f 0xff54>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x68>;
			phandle = <0x3d>;
		};

		pcie_doorbell {
			msi-parent = <0x0f 0xff55>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			num-pins = <0x04>;
		};

